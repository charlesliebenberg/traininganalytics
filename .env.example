# Port for the API server (the Vite dev server proxies /api to it)
PORT=8787
# Public URL the app is opened at (the frontend). Used for OAuth redirect URIs and the Strava webhook.
PUBLIC_URL=http://localhost:5173
# Only if the frontend calls the API on a different domain *without* a proxy: the API's public URL.
# API_URL=https://traininganalytics-api.onrender.com
# Extra origins allowed to call the API cross-origin (comma separated)
# CORS_ORIGINS=
# Password protecting the app — set this for any deployment reachable from the internet
APP_PASSWORD=

# Strava — create an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to the host of PUBLIC_URL (e.g. localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; used to verify Strava webhook subscription requests
STRAVA_WEBHOOK_VERIFY_TOKEN=change-me

# TrainingPeaks — partner API credentials (https://api.trainingpeaks.com, requires approval)
TRAININGPEAKS_CLIENT_ID=
TRAININGPEAKS_CLIENT_SECRET=
# Set to true to use the TrainingPeaks sandbox environment
TRAININGPEAKS_SANDBOX=false

# Background sync interval in minutes (polling fallback in addition to webhooks)
SYNC_INTERVAL_MINUTES=15
# Where the SQLite database lives
DATA_DIR=./data
